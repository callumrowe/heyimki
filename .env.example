# ── Core ──────────────────────────────────────────────────────────────────────

# Anthropic API key — required. Powers Sonnet (conversations) and Haiku
# (heartbeat synthesis, classification, summarisation, etc).
ANTHROPIC_API_KEY=

# OpenAI API key — required. Used for text-embedding-3-small (vault + conversation
# semantic search) and Whisper voice transcription.
OPENAI_API_KEY=

# Postgres password for the bundled `postgres` service in docker-compose.yml.
DB_PASSWORD=change-me

# Shared secret between the `api` and `baileys` services. Generate with:
#   openssl rand -hex 32
INTERNAL_SECRET=

# Shared secret for the web/desktop app login. Generate with:
#   openssl rand -hex 32
DESKTOP_SECRET=

# ── WhatsApp (Baileys) ────────────────────────────────────────────────────────

# Your WhatsApp JID — discovered from `docker compose logs -f baileys` on first
# QR-code login. Multi-device uses the @lid format, not @s.whatsapp.net.
# Example: 135132589609113@lid
YOUR_WHATSAPP_JID=
ALLOWED_JID=${YOUR_WHATSAPP_JID}

# ── Timezone and heartbeat cadence ────────────────────────────────────────────

# IANA timezone name. All reminders, daily notes, and heartbeat times are
# interpreted in this zone.
USER_TZ=Pacific/Auckland

# Heartbeat runs every N hours. Float OK (e.g. 1.5).
HEARTBEAT_HOURS=3

# Quiet hours (24h, in USER_TZ). The heartbeat skips entirely between these.
HEARTBEAT_QUIET_START=22
HEARTBEAT_QUIET_END=7

# How long without a message before the next conversation starts fresh (hours).
SESSION_GAP_HOURS=0.5

# ── Obsidian vault ────────────────────────────────────────────────────────────

# Path inside the api container where the vault is mounted. Leave as the
# default unless you change the bind mount in docker-compose.yml.
OBSIDIAN_VAULT_PATH=/vault

# ── Coding agent (self-modification) ──────────────────────────────────────────

# Where the coding-agent service pushes commits. Format: <user>/<repo>.
GITHUB_REPO=your-username/your-repo

# GitHub personal access token with `repo` scope. Used by coding-agent to push.
GITHUB_TOKEN=

# ── Web push (PWA) ────────────────────────────────────────────────────────────

# Generate a keypair once with:
#   python3 -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); \
#       print('PRIVATE:', v.private_key); print('PUBLIC:', v.public_key)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Apple Push (iOS native app) ───────────────────────────────────────────────

# Only needed if you build the Capacitor iOS app and want push notifications.
# Requires an Apple Developer account.
APNS_BUNDLE_ID=com.example.ki
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY=
# true for AltStore/dev builds, false for TestFlight/App Store
APNS_SANDBOX=true

# ── Google (Calendar + Gmail) — optional ──────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ki.example.com/auth/google/callback

# ── Web search (web_search tool) — optional ───────────────────────────────────

BRAVE_SEARCH_API_KEY=

# ── Image generation (image_gen tool) — optional ──────────────────────────────

# xAI API key for Aurora image generation.
XAI_API_KEY=

# ── 1Password (optional, for browser credential lookup) ───────────────────────

# Service account token if you want the browser tool to fetch credentials via
# the 1Password CLI inside the api container.
OP_SERVICE_ACCOUNT_TOKEN=

# ── Cache bust for Docker builds — bump to force a clean rebuild ──────────────

CACHEBUST=1
