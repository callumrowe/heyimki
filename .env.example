# Ki configuration. Run ./setup.sh to create .env interactively, or copy this
# file to .env and fill it in by hand. Never commit .env.

# ── You ───────────────────────────────────────────────────────────────────────

# Your first name. Ki uses it when talking about you in her prompts.
USER_NAME=

# Your IANA timezone. Dates, reminders, daily notes and quiet hours use it.
USER_TZ=UTC

# ── Required keys ─────────────────────────────────────────────────────────────

# Anthropic — powers conversations (Sonnet) and background work (Haiku).
ANTHROPIC_API_KEY=

# OpenAI — embeddings for vault/conversation search, and voice transcription.
OPENAI_API_KEY=

# ── Secrets (generate each with: openssl rand -hex 32) ───────────────────────

# Postgres password for the bundled database.
DB_PASSWORD=

# Service-to-service secret (WhatsApp gateway, coding agent, the ki CLI).
INTERNAL_SECRET=

# The password you type into the web app.
DESKTOP_SECRET=

# ── Optional parts of the stack ───────────────────────────────────────────────

# Comma-separated compose profiles to switch on:
#   whatsapp      WhatsApp gateway (pair by scanning a QR code)
#   coding-agent  Ki can edit her own code (write access to this repo + Docker)
#   https         Caddy with automatic TLS for KI_DOMAIN — use on a VPS
COMPOSE_PROFILES=

# ── Obsidian vault ────────────────────────────────────────────────────────────

# Path on this machine to your Obsidian vault (absolute, or relative to this
# folder). It can be a plain folder or a git repo.
KI_VAULT_PATH=./vault

# Git vaults only: with a remote, Ki pulls before writing and pushes after.
# Set to "off" to only commit locally. Plain folders ignore this.
VAULT_GIT_SYNC=auto

# How often (minutes) to pull remote vault changes and re-index edits.
VAULT_SYNC_MINUTES=5

# ── Web access ────────────────────────────────────────────────────────────────

# The web app listens on this address and port. Keep 127.0.0.1 unless you
# know you want it reachable from other machines without HTTPS.
KI_BIND_ADDRESS=127.0.0.1
KI_PORT=8000

# `https` profile: the domain pointed at this server (e.g. ki.example.com).
KI_DOMAIN=

# ── WhatsApp (`whatsapp` profile) ─────────────────────────────────────────────

# Leave empty on first run. After scanning the QR code, message the linked
# account from your own phone; the baileys logs print the JID to put here.
YOUR_WHATSAPP_JID=

# ── Coding agent (`coding-agent` profile) ─────────────────────────────────────

# Absolute path of this repo on the host. setup.sh fills it in. Needed so the
# coding agent can rebuild containers after editing code.
KI_REPO_DIR=

# Push the coding agent's commits to the repo's `origin` remote. Off by
# default: commits stay local.
CODING_AGENT_GIT_PUSH=false

# ── Heartbeat ─────────────────────────────────────────────────────────────────

# Ki reviews your notes and conversations every N hours and may message you.
HEARTBEAT_HOURS=3

# Quiet hours (24h clock, in USER_TZ): no heartbeat runs between these.
HEARTBEAT_QUIET_START=22
HEARTBEAT_QUIET_END=7

# How long (hours) without a message before a conversation starts fresh.
SESSION_GAP_HOURS=0.5

# ── Optional integrations (each switches on when its key is set) ──────────────

# Web search (Brave Search API)
BRAVE_SEARCH_API_KEY=

# Image generation and voice replies (xAI)
XAI_API_KEY=

# GitHub issues/PRs for one repo (owner/repo)
GITHUB_TOKEN=
GITHUB_REPO=

# Web push notifications for the installed web app. setup.sh generates these;
# to make a new pair: docker compose run --rm --no-deps api python3 -m src.gen_vapid
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Google (Gmail, Calendar, Drive). Redirect URI: https://<your domain>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# 1Password service account — lets the browser tools fetch logins and 2FA codes
OP_SERVICE_ACCOUNT_TOKEN=

# ── Build ─────────────────────────────────────────────────────────────────────

# Bump to force a clean rebuild of the WhatsApp gateway image.
CACHEBUST=1
